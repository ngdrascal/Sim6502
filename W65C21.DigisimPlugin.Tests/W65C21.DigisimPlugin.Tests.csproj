      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigisimPlugin.TestHelpers\DigisimPlugin.TestHelpers.csproj" />
    <ProjectReference Include="..\W65C02S.DigisimPlugin\W65C02S.DigisimPlugin.csproj" />
    <ProjectReference Include="..\W65C21.DigisimPlugin\W65C21.DigisimPlugin.csproj" />
