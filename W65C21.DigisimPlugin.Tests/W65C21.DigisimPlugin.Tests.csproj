      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The real Digisim simulation scheduler, packed for plugin tests (Digisim scripts/pack-sdk.ps1). -->
