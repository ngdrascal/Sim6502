<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Digisim plugin (Digisim ADR 0009) wrapping W65C02S.Engine as a circuit component. Point the
       host's Digisim:PluginPaths at this project's build output folder to load it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyTitle>W65C02S Digisim Plugin</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>W65C02S.DigisimPlugin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The host supplies the Digisim assemblies at run time, so they are not copied to the output. -->
    <PackageReference Include="Digisim.Sdk" Version="1.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\W65C02S.Engine\W65C02S.Engine.csproj" />
  </ItemGroup>

</Project>
